# Server-only. Never use VITE_ for model secrets.
INTENT_PROVIDER=meta
MODEL_API_KEY=
INTENT_MODEL_MAIN=muse-spark-1.3
# Use INTENT_PROVIDER=fake only for scripted development/testing.
# OpenRouter is optional: INTENT_PROVIDER=openrouter, OPENROUTER_API_KEY,
# INTENT_MODEL_MAIN=meta/muse-spark-1.3
# Data directory (default ./intent_data). The release binary also reads <dir>/config.env.
# INTENT_DATA_DIR=./intent_data
# Public HTTPS origin when behind a proxy or tunnel, e.g. https://intent.example.com
# INTENT_PUBLIC_ORIGIN=
